{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/openMarket/domain",
    "src/openMarket/application",
    "src/openMarket/infrastructure"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/openMarket/infrastructure/configuration"
  ]
}

{
  "name": "OpenMarket",
  "productName": "OpenMarket",
  "version": "1.2.0",
  "description": "Desktop application to administrate a generic market with stocks, products, categories etc...",
  "main": "dist/main.js",
  "scripts": {
    "test": "cross-env NODE_ENV=test BABEL_DISABLE_CACHE=1 NODE_OPTIONS=--no-experimental-detect-module mocha \"src/test/openMarket/**/*.spec.js\"",
    "test-all": "npm run test && npm run test:integration",
    "test:integration": "cross-env NODE_ENV=test BABEL_DISABLE_CACHE=1 NODE_OPTIONS=--no-experimental-detect-module mocha \"src/itest/**/*.js\"",
    "test-watch": "npm test -- --watch",
    "hot-server": "cross-env NODE_ENV=development node -r @babel/register src/openMarket/infrastructure/configuration/webpack/server.js",
    "build-main": "cross-env NODE_ENV=production node -r @babel/register ./node_modules/webpack/bin/webpack.js --config src/openMarket/infrastructure/configuration/webpack/webpack.config.electron.js --mode production",
    "build-renderer": "cross-env NODE_ENV=production node -r @babel/register ./node_modules/webpack/bin/webpack.js --config src/openMarket/infrastructure/configuration/webpack/webpack.config.production.js --mode production",
    "build": "rm -rf dist && npm run build-main && npm run build-renderer",
    "start": "cross-env NODE_ENV=production electron ./dist/main.js",
    "start-hot": "cross-env HOT=1 NODE_ENV=development electron ./src/openMarket/user_interface/main.development.js",
    "dev": "npm run hot-server -- --start-hot",
    "package": "npm run build && electron-builder --publish never",
    "package-win": "npm run build && electron-builder --win --x64 --publish never",
    "package-linux": "npm run build && electron-builder --linux --publish never",
    "package-mac": "npm run build && electron-builder --mac --universal --publish never",
    "package-all": "npm run build && electron-builder -mwl --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "productName": "OpenMarket",
    "appId": "com.unexpectedsoftware.openmarket",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.tools",
      "icon": "src/openMarket/user_interface/resources/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "src/openMarket/user_interface/resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "runAfterFinish": false
    },
    "linux": {
      "icon": "src/openMarket/user_interface/resources/icon.png",
      "target": [
        "deb",
        "AppImage"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UnexpectedSoftware/openMarket.git"
  },
  "keywords": [
    "market",
    "stocks",
    "desktop",
    "electron"
  ],
  "author": {
    "name": "Victor Caldentey",
    "email": "victuxbb@gmail.com",
    "url": "http://www.unexpectedsoftware.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UnexpectedSoftware/openMarket/issues"
  },
  "homepage": "http://www.unexpectedsoftware.com/",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/register": "^7.27.1",
    "@faker-js/faker": "^10.6.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-add-module-exports": "^1.0.4",
    "chai": "^4.5.0",
    "check-more-types": "^2.24.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "electron-devtools-installer": "^4.0.0",
    "express": "^4.21.2",
    "html-webpack-plugin": "^5.6.3",
    "lazy-ass": "^1.6.0",
    "mini-css-extract-plugin": "^2.9.2",
    "minimist": "^1.2.8",
    "mocha": "^10.8.2",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "sinon": "^17.0.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^7.4.2",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "chart.js": "^2.9.4",
    "deepmerge": "^4.3.1",
    "electron-debug": "^3.2.0",
    "font-awesome": "^4.7.0",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "node-thermal-printer": "1.0.5",
    "rc-menu": "^5.1.2",
    "react": "^15.7.0",
    "react-chartjs-2": "^2.11.2",
    "react-datepicker": "^0.48.0",
    "react-dom": "^15.7.0",
    "react-notification-system": "^0.2.17",
    "react-notification-system-redux": "^1.1.6",
    "react-redux": "^5.1.2",
    "react-router": "^3.2.6",
    "react-router-redux": "^4.0.8",
    "react-table": "6.8.6",
    "redux": "^3.7.2",
    "redux-form": "^6.8.0",
    "redux-logger": "^2.10.2",
    "redux-observable": "^0.14.1",
    "redux-thunk": "^2.4.2",
    "rxjs": "^5.5.12",
    "source-map-support": "^0.5.21",
    "uuid": "^9.0.1"
  }
}
